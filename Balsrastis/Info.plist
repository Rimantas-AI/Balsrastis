<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

	<!-- ============================================================ -->
	<!-- CRITICAL: Hides the app from the Dock and Application Switcher -->
	<!-- ============================================================ -->
	<key>LSUIElement</key>
	<true/>

	<!-- ============================================================ -->
	<!-- Privacy usage strings (required by macOS / App Store review) -->
	<!-- ============================================================ -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Balsraštis uses the microphone to record your voice and transcribe speech to text.</string>

	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Balsraštis uses speech recognition to transcribe your recorded voice into text.</string>

	<!-- ============================================================ -->
	<!-- Bundle metadata                                               -->
	<!-- ============================================================ -->
	<key>CFBundleName</key>
	<string>Balsrastis</string>

	<!-- Rodomas vardas su lietuviška raide; failas diske lieka ASCII (Balsrastis.app),
	     kad build'as ir keliai nepriklausytų nuo koduotės. -->
	<key>CFBundleDisplayName</key>
	<string>Balsraštis</string>

	<key>CFBundleIdentifier</key>
	<string>lt.balsrastis.app</string>

	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>

	<key>CFBundlePackageType</key>
	<string>APPL</string>

	<!-- Bump these with every release tag: Diagnostics → Copy Report prints
	     CFBundleShortVersionString, so a stale value silently mislabels which
	     build produced a set of measurements. -->
	<key>CFBundleVersion</key>
	<string>21</string>

	<key>CFBundleShortVersionString</key>
	<string>1.7.0</string>

	<!-- Blank in every CI-built release. For a closed-pilot copy, this is
	     stamped with the tester's name after the build, so Settings and Copy
	     Report identify whose build it is without needing a separate build
	     per tester. -->
	<key>BalsrastisTesterName</key>
	<string></string>

	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>

	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>

	<!-- ============================================================ -->
	<!-- Minimum macOS version: Monterey (12.0)                       -->
	<!-- ============================================================ -->
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>

	<!-- ============================================================ -->
	<!-- Prevent accidental termination                                -->
	<!-- ============================================================ -->
	<key>NSSupportsAutomaticTermination</key>
	<false/>

	<key>NSSupportsSuddenTermination</key>
	<false/>

	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Rimantas Dubinas. All rights reserved.</string>

</dict>
</plist>
